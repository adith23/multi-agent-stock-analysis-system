# ============================================
# Multi-Agent Stock Analysis System
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your connection strings / API keys.
# NEVER commit .env to version control.
# ============================================

# ============================================
# Neon PostgreSQL
# (Get from: https://neon.tech → Project Dashboard → Connection Details)
# ============================================
DATABASE_URL=postgresql://your_user:your_password@ep-xxxx-xxxx-123456.us-east-1.aws.neon.tech/stockanalysis?sslmode=require
POSTGRES_DB=stockanalysis
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=ep-xxxx-xxxx-123456.us-east-1.aws.neon.tech
POSTGRES_PORT=5432

# ============================================
# MongoDB Atlas
# (Get from: https://cloud.mongodb.com → Connect → Drivers)
# ============================================
MONGODB_URL=mongodb+srv://stockanalysis_user:your_password@stockanalysis-cluster.abc123.mongodb.net/stockanalysis?retryWrites=true&w=majority
MONGODB_DB=stockanalysis

# ============================================
# Redis Cloud
# (Get from: https://app.redislabs.com → Database → Configuration)
# Note: rediss:// (double 's') = Redis over TLS
# Free tier = 1 database — Celery broker, result backend, and cache share it
# ============================================
REDIS_URL=rediss://default:your_password@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345
CELERY_BROKER_URL=rediss://default:your_password@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345
CELERY_RESULT_BACKEND=rediss://default:your_password@redis-12345.c123.us-east-1-1.ec2.redns.redis-cloud.com:12345

# ============================================
# Confluent Cloud Kafka
# (Get from: https://confluent.cloud → Cluster → Cluster Settings / API Keys)
# ============================================
KAFKA_BOOTSTRAP_SERVERS=pkc-abc123.us-east-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=your_api_key
KAFKA_SASL_PASSWORD=your_api_secret
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# ============================================
# Django Configuration
# ============================================
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-2026!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# ============================================
# LLM API Keys
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Data Source API Keys
# ============================================
FRED_API_KEY=your-fred-api-key-here
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here
NEWS_API_KEY=your-newsapi-key-here

# ============================================
# Testing (Optional — Neon database branching)
# Create a 'test' branch in Neon dashboard and paste its URL here
# ============================================
# TEST_DATABASE_URL=postgresql://your_user:your_password@ep-xxxx-xxxx-123456.us-east-1.aws.neon.tech/stockanalysis?sslmode=require
