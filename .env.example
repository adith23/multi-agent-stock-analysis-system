# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100
API_MAX_JSON_BYTES=65536
API_MAX_JSON_DEPTH=8
ALLOW_API_AGENT_INPUT_OVERRIDES=False
PM_REVIEW_TTL_HOURS=72

# PostgreSQL (Django ORM and LangGraph checkpoints)
DATABASE_URL=postgresql://stockanalysis:stockanalysis@localhost:5432/stockanalysis
LANGGRAPH_DATABASE_URL=postgresql://stockanalysis:stockanalysis@localhost:5432/stockanalysis
POSTGRES_DB=stockanalysis
POSTGRES_USER=stockanalysis
POSTGRES_PASSWORD=replace-with-a-database-password

# Redis (cache, Celery broker, Celery results)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google Gemini
GOOGLE_API_KEY=replace-with-a-google-api-key
TAVILY_API_KEY=
LLM_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=60

# Public data ingestion (enable only the sources for which keys are configured)
FINNHUB_API_KEY=
FRED_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
# SEC requires a descriptive User-Agent, for example: Analyst Name email@example.com
SEC_EDGAR_IDENTITY=

# Logging and audit
LOG_LEVEL=INFO
AUDIT_BODY_MAX_BYTES=16384
ML_MODEL_DIR=../ml_models

# Tests default to SQLite when this is omitted. CI sets PostgreSQL explicitly.
# TEST_DATABASE_URL=postgresql://stockanalysis:stockanalysis@localhost:5432/stockanalysis_test
